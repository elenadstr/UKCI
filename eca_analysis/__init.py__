)
from .episode_stats import episode_stats, national_series_from_dates
from .compound_eca_windows import (
    WindowConfig,
    sliding_windows,
    get_percentile,
    value_from_percentile,
    analyse_region,
    run_window_analysis,
)

__all__ = [
